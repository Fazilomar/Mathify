# Django Core Settings
SECRET_KEY=generate-a-strong-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# Database (PostgreSQL recommended for production: Neon, Supabase, Vercel Postgres, or AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/mathify_db

# CORS Configuration (Set to your deployed frontend Vercel URL)
CORS_ALLOWED_ORIGINS=https://mathify-frontend.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# AI Mathematics Tutor (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Google OAuth 2.0
# Register this exact redirect URI in Google Cloud for local development:
# http://127.0.0.1:8000/api/accounts/oauth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000/api/accounts/oauth/google/callback/
FRONTEND_URL=http://localhost:5173

# Optional: Redis Cache (Upstash, Redis Cloud, etc.)
# REDIS_URL=redis://default:password@host:6379

# Optional: Email / SMTP for Password Reset
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=