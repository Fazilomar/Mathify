# Django Core Settings
SECRET_KEY=generate-a-strong-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# Database (PostgreSQL recommended for production: Neon, Supabase, Vercel Postgres, or AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/mathify_db


CORS_ALLOWED_ORIGINS=https://mathify-frontend.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# AI Mathematics Tutor (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://backend-url.vercel.app/api/accounts/oauth/google/callback/
FRONTEND_URL=https://frontend-url.vercel.app

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

TELEGRAM_API_ID=your_api_id_number
TELEGRAM_API_HASH=your_api_hash_string
